# Copy this file to .env and fill in the values. .env is never committed.

# Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# REQUIRED hard spending cap in USD per calendar month (UTC).
# Rigorlight refuses to make any Claude API call if this is not set.
# Set it to ~10% of your total monthly API budget, and set the SAME number
# as the workspace spend limit in the Anthropic Console (see docs/COSTS.md).
MONTHLY_BUDGET_USD=

# Model and effort (optional). Opus is the most capable; claude-sonnet-5-5 and
# claude-haiku-5-5 are cheaper per token.
RIGORLIGHT_MODEL=claude-opus-5-5
RIGORLIGHT_EFFORT=medium

# Where the local spending ledger is stored
RIGORLIGHT_LEDGER=data/spend_ledger.sqlite3

# Free scholarly APIs
S2_API_KEY=
CONTACT_EMAIL=
